# MongoDB connection string (Atlas or self-hosted). Never commit the real value.
MONGODB_URI="mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/ottawise?retryWrites=true&w=majority"

# Long random string (32+ chars) used to sign CSRF tokens and hash session IDs.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=""

# Public site URL (canonical URLs, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL="https://ottawisegaragedoors.ca"

# Largest single multipart request the host accepts, in bytes.
# Vercel Functions reject request bodies over 4.5 MB, so the default is 4 MB.
# Files above this go through the chunked upload fallback (still capped at 8 MB).
NEXT_PUBLIC_UPLOAD_DIRECT_LIMIT="4000000"

# Used ONLY by `npm run create-admin`. Remove from the environment afterwards.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME="Administrator"

# Email notifications for door configurator requests (SMTP).
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=the Gmail address,
# SMTP_PASS=a Google "App Password" (requires 2-Step Verification), not the normal password.
# If these are empty, requests are still saved and shown in the admin; no email is sent.
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
NOTIFY_EMAIL="ottawisegaragedoors@gmail.com"
MAIL_FROM="Ottawise Website <ottawisegaragedoors@gmail.com>"
